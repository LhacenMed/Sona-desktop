{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Sona (GDB)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${command:cmake.launchTargetPath}",
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "miDebuggerPath": "C:/Qt/Tools/mingw1310_64/bin/gdb.exe",
      "environment": [
        { "name": "PATH", "value": "C:/Qt/6.10.3/mingw_64/bin;C:/Qt/Tools/mingw1310_64/bin;${env:PATH}" },
        { "name": "QT_QPA_PLATFORM_PLUGIN_PATH", "value": "C:/Qt/6.10.3/mingw_64/plugins/platforms" },
        { "name": "QML_IMPORT_PATH", "value": "C:/Qt/6.10.3/mingw_64/qml" }
      ],
      "externalConsole": false,
      "setupCommands": [
        { "description": "Enable pretty-printing", "text": "-enable-pretty-printing", "ignoreFailures": true }
      ]
    }
  ]
}
